    "# requirments generation block\n",
    "def generate_requirements(input_data, file_name):\n",
    "\n",
    "    prompt_template = PromptTemplate(\n",
    "        input_variables=[\"painting_name\", \"artist\", \"date\"],\n",
    "        template=\"\"\"\n",
    "    You are a cultural heritage feature extraction system.\n",
    "\n",
    "    Your task is to classify paintings using ONLY the allowed labels.\n",
    "\n",
    "    # Allowed painting styles (choose exactly ONE):\n",
    "    Expressionism, Abstractionism, Art Nouveau, Modern Art, Baroque, Realism, \n",
    "    Renaissance, Minimalism, Naive Art, Rococo, Romanticism, Post Impressionism\n",
    "    \n",
    "    # Allowed painting genres (choose 1 or 2):\n",
    "    Cityscape, Illustration, Landscape, History painting, Nude painting, Portrait, \n",
    "    Religious painting, Sketch and Study, Nature morte, Genre Painting, Animal Painting\n",
    "\n",
    "    # Rules:\n",
    "    - painting_style: ALWAYS choose exactly ONE label\n",
    "    - painting_genre: choose ONE by default, or TWO only if both are clearly supported\n",
    "    - Do NOT repeat or mix style and genre concepts\n",
    "    - Return only valid JSON\n",
    "\n",
    "    \n",
    "    Painting name:\n",
    "    {painting_name}\n",
    "        \n",
    "    Artist:\n",
    "    {artist}\n",
    "\n",
    "    Date:\n",
    "    {date}\n",
    "\n",
    "        \n",
    "    Return ONLY this JSON format:\n",
    "\n",
    "    {{\n",
    "        \"painting_style\": \"...\",\n",
    "        \"painting_genre\": [\"...\"]\n",
    "    }}\n",
    "\n",
    "    If two genres apply:\n",
    "\n",
    "    {{\n",
    "        \"painting_style\": \"...\",\n",
    "        \"painting_genre\": [\"...\", \"...\"]\n",
    "    }}\n",
    "\n",
    "    Do not include explanations.\n",
    "    Do not use markdown.\n",
    "        \n",
    "    \"\"\"\n",
    "    )\n",
    "    \n",
    "   \n",
    "    # Requirement generation\n",
    "    def extend_dataset(prompt_template, painting_name, artist, date): #generate_requirement(prompt_template, benefit, tags):\n",
    "\n",
    "        prompt = prompt_template.format(painting_name=painting_name, artist=artist, date=date)\n",
    "       \n",
    "        response = model.invoke(prompt)\n",
    "    \n",
    "        return str(response).strip()\n",
    "    \n",
    "    \n",
    "    # clean output\n",
    "    def clean_generated(text):\n",
    "        if text is None:\n",
    "            return \"\"\n",
    "\n",
    "        text = str(text)\n",
    "\n",
    "        # remove reasoning blocks\n",
    "        if \"</think>\" in text:\n",
    "            text = text.split(\"</think>\")[-1]\n",
    "    \n",
    "        text = re.sub(r\"<think>.*\", \"\", text, flags=re.DOTALL | re.IGNORECASE)\n",
    "    \n",
    "        # fallback cleanup\n",
    "        text = text.replace(\"\\n\", \" \").strip()\n",
    "        text = \" \".join(text.split())\n",
    "        \n",
    "        return text\n",
    "    \n",
    "    \n",
    "    # Evaluation pipeline\n",
    "    def run_experiment(prompt):\n",
    "    \n",
    "        df_exp = input_data.copy()\n",
    "        \n",
    "        generated = []\n",
    "\n",
    "\n",
    "        def process_row(row):\n",
    "            pred = extend_dataset(prompt, row.painting_name, row.artist, row.date)\n",
    "            pred = clean_generated(pred)\n",
    "        \n",
    "            try:\n",
    "                return json.loads(pred) if pred and pred.strip() else {\n",
    "                    \"painting_style\": None,\n",
    "                    \"painting_genre\": None\n",
    "                }\n",
    "            except:\n",
    "                return {\n",
    "                    \"painting_style\": None,\n",
    "                    \"painting_genre\": None\n",
    "                }\n",
    "\n",
    "        generated = []\n",
    "\n",
    "        with ThreadPoolExecutor(max_workers=4) as executor:\n",
    "            futures = [\n",
    "                executor.submit(process_row, row)\n",
    "                for row in df_exp.itertuples(index=False)\n",
    "            ]\n",
    "        \n",
    "            for f in tqdm(as_completed(futures), total=len(futures)):\n",
    "                generated.append(f.result())\n",
    "\n",
    "        \n",
    "        df_expanded = pd.json_normalize(generated)\n",
    "        df_expanded = df_expanded[[\"painting_style\", \"painting_genre\"]]\n",
    "\n",
    "        df_final = pd.concat([df_exp.reset_index(drop=True), df_expanded.reset_index(drop=True)], axis=1)\n",
    "    \n",
    "        return df_final\n",
    "    \n",
    "    \n",
    "    # Run experiments\n",
    "    print(\"Running NAIVE prompt experiment\")\n",
    "    results = run_experiment(prompt_template)\n",
    "    \n",
    "    # Save results\n",
    "    results.to_csv(file_name, index=False, encoding=\"utf-8-sig\")\n",
    "\n",
    "\n",
    "generate_requirements(painting_df, \"processed_data/extended_paintings_dataset_BIRD.csv\")"
   ]
  },
